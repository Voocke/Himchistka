<Page x:Class="Himchistka.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="900"
      Title="Корзина заказа — Химчистка">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Корзина заказа" FontSize="24"
                   FontWeight="Bold" Foreground="{StaticResource DarkContrast}"
                   Margin="0,0,0,15"/>

        <!-- Список позиций в корзине -->
        <ListView x:Name="listCart" Grid.Row="1"
                  BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                            CornerRadius="6" Margin="4" Padding="12"
                            Background="{StaticResource AccentBackground}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold" FontSize="15"
                                           Foreground="{StaticResource DarkContrast}"
                                           Text="{Binding ProductName}"/>
                                <TextBlock FontSize="13" Foreground="#555" Margin="0,2,0,0">
                                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding MaterialName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14"
                                       Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}"/>

                            <TextBox Grid.Column="2" Text="{Binding Quantity}"
                                     TextAlignment="Center" VerticalAlignment="Center"
                                     LostFocus="Qty_LostFocus" KeyDown="Qty_KeyDown"
                                     PreviewTextInput="NumberValidationTextBox"
                                     MaxLength="3" FontSize="14"/>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{StaticResource DarkContrast}"
                                       Text="{Binding Sum, StringFormat={}{0:N0} ₽}"/>

                            <Button Grid.Column="4" Content="Удалить"
                                    Background="{StaticResource WarningColor}"
                                    Click="Remove_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Итоговая строка и кнопки -->
        <Border Grid.Row="2" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="6" Padding="15" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Итого к оплате: " FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource DarkContrast}"/>
                    <TextBlock x:Name="tbTotal" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource DarkContrast}" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="История заказов" Click="OrderHistory_Click"
                            Background="{StaticResource DarkContrast}" Margin="4"/>
                    <Button Content="Оформить заказ" Click="CreateOrder_Click"
                            Background="{StaticResource AccentColor}" FontWeight="Bold"
                            Padding="15,6"/>
                    <Button Content="Очистить" Click="Clear_Click"
                            Background="{StaticResource WarningColor}" Margin="8,4"/>
                    <Button Content="Назад в каталог" Click="Back_Click"
                            Background="{StaticResource SecondaryButtonColor}" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
