<Page x:Class="Himchistka.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Авторизация — Химчистка">

    <Grid Background="{StaticResource MainBackground}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="360" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="8" Padding="25">
            <StackPanel>
                <Image Source="/Images/logo.png" Height="70" Stretch="Uniform"
                       Margin="0,0,0,15"/>

                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource DarkContrast}"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Логин (Email или телефон):" FontWeight="SemiBold"
                           Foreground="{StaticResource DarkContrast}"/>
                <TextBox x:Name="txtLogin" FontSize="14"/>

                <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0,5,0,0"
                           Foreground="{StaticResource DarkContrast}"/>
                <PasswordBox x:Name="txtPassword" FontSize="14"/>

                <Button Content="Войти" Margin="0,15,0,5"
                        Background="{StaticResource AccentColor}"
                        FontWeight="Bold" Click="Login_Click"/>

                <Button Content="Войти как гость" Margin="0,5,0,0"
                        Background="{StaticResource SecondaryButtonColor}"
                        Click="Guest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
