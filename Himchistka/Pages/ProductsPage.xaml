<Page x:Class="Himchistka.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="900"
      Title="Каталог услуг — Химчистка">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска, фильтрации и сортировки -->
        <Border Grid.Row="0" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <WrapPanel x:Name="filterPanel" VerticalAlignment="Center">
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="5,0,5,0"
                           FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                <ComboBox x:Name="cmbSort" Width="140" Margin="0,0,12,0"
                          SelectionChanged="Filters_Changed"/>

                <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="5,0,5,0"
                           FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                <ComboBox x:Name="cmbFilter" Width="160" Margin="0,0,12,0"
                          SelectionChanged="Filters_Changed"/>

                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0,5,0"
                           FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                <TextBox x:Name="txtSearch" Width="180" Margin="0,0,10,0"
                         TextChanged="Filters_Changed"
                         ToolTip="Поиск по названию услуги, материалу или категории"/>

                <Button x:Name="btnResetFilters" Content="Сбросить" Click="ResetFilters_Click"
                        Background="{StaticResource SecondaryButtonColor}" Margin="4,0,12,0" Padding="8,4"
                        ToolTip="Сбросить все установленные критерии фильтрации и поиска"/>

                <TextBlock x:Name="tbRecordCount" Text="Найдено: 0 из 0" VerticalAlignment="Center"
                           FontWeight="Bold" Foreground="{StaticResource DarkContrast}" Margin="8,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Список услуг / товаров -->
        <ListView x:Name="listProduct" Grid.Row="1"
                  MouseDoubleClick="listProduct_MouseDoubleClick"
                  BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{StaticResource LightBlue}"
                            Background="{Binding RowColor}"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <!-- Картинка услуги -->
                            <Image Grid.Column="0" Source="{Binding ImagePath}"
                                   Width="95" Height="95" Stretch="Uniform"
                                   VerticalAlignment="Center"/>

                            <!-- Информация об услуге -->
                            <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource DarkContrast}">
                                    <Run Text="{Binding name}"/>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="13">
                                    <Run Text="Категория: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="13">
                                    <Run Text="Материал: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding MaterialName, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#666">
                                    <Run Text="Количество / объем: "/>
                                    <Run Text="{Binding amount}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Стоимость и скидка -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock FontSize="18" FontWeight="Bold"
                                           Foreground="{Binding PriceBrush}"
                                           HorizontalAlignment="Right"
                                           Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}"/>
                                
                                <TextBlock Foreground="Red" FontSize="14"
                                           TextDecorations="Strikethrough"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Text="{Binding price, StringFormat={}{0:N0} ₽}"/>

                                <Border Background="{StaticResource AccentColor}" CornerRadius="3"
                                        Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right"
                                        Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DiscountText}" Foreground="White"
                                               FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Панель кнопок действий внизу -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnAddProduct" Content="Добавить услугу" Click="AddProduct_Click"
                    Background="{StaticResource AccentColor}" Margin="4,0" Padding="12,5"/>
            <Button x:Name="btnEditProduct" Content="Редактировать услугу" Click="EditProduct_Click"
                    Background="{StaticResource DarkContrast}" Margin="4,0" Padding="12,5"/>
            <Button x:Name="btnDelete" Content="Удалить услугу" Click="Del_Click"
                    Background="{StaticResource WarningColor}" Margin="4,0" Padding="12,5"/>
            <Button x:Name="btnTables" Content="Таблицы БД" Click="Tables_Click"
                    Background="{StaticResource AccentColor}" Margin="4,0" Padding="12,5"/>
            <Button Content="Корзина" Click="Cart_Click"
                    Background="{StaticResource AccentColor}" Margin="4,0" Padding="12,5"/>
            <Button x:Name="btnOrders" Content="Заказы" Click="Orders_Click"
                    Background="{StaticResource DarkContrast}" Margin="4,0" Padding="12,5"/>
            <Button Content="Выход" Click="Exit_Click"
                    Background="{StaticResource SecondaryButtonColor}" Margin="4,0" Padding="12,5"/>
        </StackPanel>
    </Grid>
</Page>
