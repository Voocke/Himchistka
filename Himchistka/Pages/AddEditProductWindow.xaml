<Window x:Class="Himchistka.Pages.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Himchistka.Pages"
        mc:Ignorable="d"
        Title="Управление услугой"
        Height="540" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">

    <Border Padding="20" Background="{StaticResource AccentBackground}" Margin="12"
            CornerRadius="8" BorderBrush="{StaticResource LightBlue}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="tbTitle" Grid.Row="0" Text="Услуга / Изделие" FontSize="20"
                       FontWeight="Bold" Foreground="{StaticResource DarkContrast}" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование услуги:*" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="tbName" Grid.Row="0" Grid.Column="1" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Категория изделия:*" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbCategory" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип материала:*" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbMaterial" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Базовая цена (₽):*" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="tbPrice" Grid.Row="3" Grid.Column="1" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Скидка (%):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="tbDiscount" Grid.Row="4" Grid.Column="1" Margin="0,3" Text="0"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Объем / фасовка:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="tbAmount" Grid.Row="5" Grid.Column="1" Margin="0,3" Text="1 шт."/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Файл изображения:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbImage" Grid.Row="6" Grid.Column="1" Margin="0,3" IsEditable="True"/>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="Save_Click" Width="120"
                        Background="{StaticResource AccentColor}" FontWeight="Bold"/>
                <Button Content="Отмена" Click="Cancel_Click" Width="100"
                        Background="{StaticResource SecondaryButtonColor}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
