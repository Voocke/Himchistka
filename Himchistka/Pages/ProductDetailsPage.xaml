<Page x:Class="Himchistka.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Детали услуги">

    <Grid Margin="25">
        <Border Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Фото услуги -->
                <Border Grid.Column="0" Background="White" CornerRadius="6"
                        BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                        Padding="10" VerticalAlignment="Top">
                    <Image Width="250" Height="250" Stretch="Uniform"
                           Source="{Binding ImagePath}"/>
                </Border>

                <!-- Описание и параметры -->
                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{StaticResource DarkContrast}"
                               Text="{Binding name}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource DarkContrast}"
                                   Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}"/>

                        <TextBlock FontSize="16" Foreground="Red"
                                   TextDecorations="Strikethrough" Margin="15,4,0,0"
                                   Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding price, StringFormat={}{0:N0} ₽}"/>

                        <Border Background="{StaticResource AccentColor}" CornerRadius="3"
                                Padding="8,3" Margin="10,0,0,0"
                                Visibility="{Binding HasDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DiscountText}" Foreground="White"
                                       FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Separator Margin="0,15" Background="{StaticResource LightBlue}"/>

                    <TextBlock Margin="0,4" FontSize="14">
                        <Run Text="Категория изделия: " FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Margin="0,4" FontSize="14">
                        <Run Text="Тип ткани / материала: " FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                        <Run Text="{Binding MaterialName, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBlock Margin="0,4" FontSize="14">
                        <Run Text="Количество / объем: " FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                        <Run Text="{Binding amount}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,10" VerticalAlignment="Center">
                        <TextBlock Text="Количество услуг:" FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkContrast}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="tbQty" Width="70" Text="1" TextAlignment="Center"
                                 FontSize="14" Margin="0" MaxLength="3"
                                 PreviewTextInput="NumberValidationTextBox"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Добавить в корзину" Width="170" Height="36"
                                Background="{StaticResource AccentColor}"
                                FontWeight="Bold" Click="AddToCart_Click"/>

                        <Button x:Name="btnEditStaff" Content="Редактировать услугу" Width="170" Height="36"
                                Background="{StaticResource DarkContrast}" Margin="8,4,4,4"
                                Click="EditStaff_Click"/>

                        <Button Content="Назад к каталогу" Width="140" Height="36"
                                Background="{StaticResource SecondaryButtonColor}"
                                Margin="8,4,4,4" Click="Back_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
