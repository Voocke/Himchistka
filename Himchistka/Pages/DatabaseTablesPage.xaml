<Page x:Class="Himchistka.Pages.DatabaseTablesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="950"
      Title="Управление таблицами базы данных">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Навигационное меню по всем таблицам БД -->
        <Border Grid.Column="0" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Таблицы БД" FontSize="18"
                           FontWeight="Bold" Foreground="{StaticResource DarkContrast}"
                           Margin="5,0,0,10"/>

                <ListBox x:Name="listTables" SelectionChanged="ListTables_SelectionChanged"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Услуги (product)" Tag="product"/>
                    <ListBoxItem Content="Заказы (order)" Tag="order"/>
                    <ListBoxItem Content="Состав заказов (productOrder)" Tag="productOrder"/>
                    <ListBoxItem Content="Категории (category)" Tag="category"/>
                    <ListBoxItem Content="Материалы (material)" Tag="material"/>
                    <ListBoxItem Content="Единицы измерения (unit)" Tag="unit"/>
                    <ListBoxItem Content="Статусы заказов (status)" Tag="status"/>
                    <ListBoxItem Content="Пользователи (user)" Tag="user"/>
                    <ListBoxItem Content="Роли (role)" Tag="role"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Правая панель: Содержимое выбранной таблицы и CRUD-действия -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок таблицы и бейдж роли -->
            <Border Grid.Row="0" Background="{StaticResource AccentBackground}"
                    BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="tbTableTitle" Text="Таблица: Услуги" FontSize="18"
                                   FontWeight="Bold" Foreground="{StaticResource DarkContrast}"/>
                        <TextBlock x:Name="tbRecordCount" Text="Всего записей: 0" FontSize="12"
                                   Foreground="#555" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" x:Name="badgeRole" CornerRadius="4" Padding="10,4"
                            Background="{StaticResource AccentColor}" VerticalAlignment="Center">

                    </Border>
                </Grid>
            </Border>

            <!-- Панель поиска -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource LightBlue}"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Быстрый поиск:" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}" Margin="0,0,10,0"/>
                    <TextBox x:Name="txtSearch" Grid.Column="1" Margin="0"
                             TextChanged="TxtSearch_TextChanged" ToolTip="Поиск по ключевым полям таблицы"/>
                </Grid>
            </Border>

            <!-- DataGrid таблицы данных -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LightBlue}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <DataGrid x:Name="dgTableData" AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" Background="Transparent"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E8E8"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          MouseDoubleClick="DgTableData_MouseDoubleClick"
                          AlternatingRowBackground="#F9FBFD">
                </DataGrid>
            </Border>

            <!-- Нижняя панель действий CRUD -->
            <Border Grid.Row="3" Background="{StaticResource AccentBackground}"
                    BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnAdd" Content="Добавить запись" Click="Add_Click"
                                Background="{StaticResource AccentColor}" Margin="0,0,6,0" Padding="12,5"/>
                        <Button x:Name="btnEdit" Content="Редактировать" Click="Edit_Click"
                                Background="{StaticResource DarkContrast}" Margin="0,0,6,0" Padding="12,5"/>
                        <Button x:Name="btnDelete" Content="Удалить запись" Click="Delete_Click"
                                Background="{StaticResource WarningColor}" Margin="0,0,6,0" Padding="12,5"/>
                        <Button Content="Обновить" Click="Refresh_Click"
                                Background="{StaticResource SecondaryButtonColor}" Margin="0,0,6,0" Padding="10,5"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Назад в каталог" Click="BackToCatalog_Click"
                            Background="{StaticResource SecondaryButtonColor}" Padding="14,5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
