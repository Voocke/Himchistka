<Window x:Class="Himchistka.Pages.AddEditProductOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Himchistka.Pages"
        mc:Ignorable="d"
        Title="Позиция заказа"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">

    <Border Padding="20" Background="{StaticResource AccentBackground}" Margin="12"
            CornerRadius="8" BorderBrush="{StaticResource LightBlue}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="tbTitle" Grid.Row="0" Text="Позиция заказа" FontSize="18"
                       FontWeight="Bold" Foreground="{StaticResource DarkContrast}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Заказ:*" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbOrder" SelectedValuePath="id" Margin="0,2,0,6"/>

                <TextBlock Text="Услуга / Изделие:*" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbProduct" DisplayMemberPath="name" SelectedValuePath="id" Margin="0,2,0,6"/>

                <TextBlock Text="Статус выполнения:*" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbStatus" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,2,0,6"/>

                <TextBlock Text="Единица измерения:*" FontWeight="SemiBold"/>
                <ComboBox x:Name="cbUnit" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,2,0,6"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="Save_Click" Width="110"
                        Background="{StaticResource AccentColor}" FontWeight="Bold"/>
                <Button Content="Отмена" Click="Cancel_Click" Width="90"
                        Background="{StaticResource SecondaryButtonColor}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
