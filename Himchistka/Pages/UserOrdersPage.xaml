<Page x:Class="Himchistka.Pages.UserOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Himchistka.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="950"
      Title="История моих заказов — Химчистка">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="История моих заказов" FontSize="24"
                       FontWeight="Bold" Foreground="{StaticResource DarkContrast}"/>

            <TextBlock x:Name="tbClientInfo" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold" Foreground="#555"/>
        </Grid>

        <!-- Верхняя плашка сводной статистики -->
        <Border Grid.Row="1" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="8" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Сумма всех заказов -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Сумма всех заказов" FontSize="13" Foreground="#555"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tbTotalOrdersSum" Text="0 ₽" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DarkContrast}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Разделитель -->
                <Rectangle Grid.Column="1" Fill="{StaticResource LightBlue}" Margin="0,5"/>

                <!-- Количество заказов -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Всего заказов" FontSize="13" Foreground="#555"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tbTotalOrdersCount" Text="0" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DarkContrast}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Разделитель -->
                <Rectangle Grid.Column="3" Fill="{StaticResource LightBlue}" Margin="0,5"/>

                <!-- Количество услуг -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="Всего услуг в заказах" FontSize="13" Foreground="#555"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="tbTotalItemsCount" Text="0 шт." FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource DarkContrast}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="2" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0,5,0"
                           FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                <TextBox x:Name="txtSearch" Width="220" Margin="0,0,20,0"
                         TextChanged="Filter_Changed"
                         ToolTip="Поиск по номеру заказа или названию услуги"/>

                <TextBlock Text="Статус заказа:" VerticalAlignment="Center" Margin="5,0,5,0"
                           FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                <ComboBox x:Name="cmbStatusFilter" Width="180"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>
        </Border>

        <!-- Список заказов клиента -->
        <Grid Grid.Row="3">
            <ListView x:Name="listOrders"
                      BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,6" Padding="14" CornerRadius="8"
                                BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                                Background="White">
                            <StackPanel>
                                <!-- Верхняя плашка карточки заказа -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Заказ №" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkContrast}"/>
                                        <TextBlock Text="{Binding id, Mode=OneWay}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkContrast}"/>
                                        <TextBlock Text=" от " FontSize="14" Foreground="#666" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding dateOfCart, Mode=OneWay, StringFormat='dd.MM.yyyy HH:mm'}"
                                                   FontSize="14" Foreground="#444" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Бейдж общего статуса -->
                                    <Border Grid.Column="1" Background="{Binding OrderStatusColor, Mode=OneWay}"
                                            CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OrderStatus, Mode=OneWay}" Foreground="White"
                                                   FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Separator Margin="0,10,0,10" Background="{StaticResource LightBlue}"/>

                                <!-- Список позиций (услуг) в заказе и их статусы -->
                                <TextBlock Text="Состав заказа:" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource DarkContrast}" Margin="0,0,0,6"/>

                                <ItemsControl ItemsSource="{Binding GroupedItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" Background="{StaticResource AccentBackground}">
                                                <Border Padding="10,6" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Название и описание услуги -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14"
                                                                       Foreground="{StaticResource DarkContrast}"/>
                                                            <TextBlock Text="{Binding CategoryAndMaterial}" FontSize="12" Foreground="#666" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Количество -->
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13"
                                                                   Text="{Binding Quantity, StringFormat='{}Кол-во: {0} шт.'}"/>

                                                        <!-- Сумма позиции -->
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="{StaticResource DarkContrast}"
                                                                   Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}"/>

                                                        <!-- Статус конкретной услуги -->
                                                        <Border Grid.Column="3" Background="{Binding StatusColor}"
                                                                CornerRadius="3" Padding="8,3"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusName}" Foreground="White"
                                                                       FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,10,0,10" Background="{StaticResource LightBlue}"/>

                                <!-- Итоговая сумма по заказу -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Дата готовности/выдачи: " FontSize="13" Foreground="#666"/>
                                        <TextBlock Text="{Binding dateOfBuy, Mode=OneWay, StringFormat='dd.MM.yyyy', TargetNullValue='В процессе обработки'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Итого по заказу: " FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DarkContrast}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalSum, Mode=OneWay, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkContrast}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Блок сообщения, если заказов нет -->
            <Border x:Name="panelEmpty" Background="{StaticResource AccentBackground}"
                    BorderBrush="{StaticResource LightBlue}" BorderThickness="1"
                    CornerRadius="8" Padding="30" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="У вас пока нет оформленных заказов" FontSize="18"
                               FontWeight="Bold" Foreground="{StaticResource DarkContrast}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Выберите подходящие услуги в каталоге и оформите заказ через корзину."
                               FontSize="14" Foreground="#666" Margin="0,8,0,15"
                               HorizontalAlignment="Center"/>
                    <Button Content="Перейти в каталог услуг" Click="BackToCatalog_Click"
                            Background="{StaticResource AccentColor}" Padding="15,6"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Кнопки навигации внизу -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Назад в корзину" Click="BackToCart_Click"
                    Background="{StaticResource AccentColor}" Padding="15,6" Margin="6,0"/>
            <Button Content="В каталог услуг" Click="BackToCatalog_Click"
                    Background="{StaticResource SecondaryButtonColor}" Padding="15,6" Margin="6,0"/>
        </StackPanel>
    </Grid>
</Page>