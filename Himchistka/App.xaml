<Application x:Class="Himchistka.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Himchistka"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Цветовая палитра: голубой/светло-синий и контрастный синий/тёмно-синий -->
        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBackground" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="LightBlue" Color="#BBDEFB"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="DarkContrast" Color="#0D47A1"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FF8080"/>
        <SolidColorBrush x:Key="SecondaryButtonColor" Color="#90A4AE"/>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Background" Value="{StaticResource MainBackground}"/>
        </Style>

        <Style TargetType="Page">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Background" Value="{StaticResource MainBackground}"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource LightBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
