<Window x:Class="Himchistka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Himchistka"
        mc:Ignorable="d"
        Title="Химчистка"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        Icon="/Images/logo.png"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Шапка в стиле демоэкзамена -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBackground}"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Images/logo.png"
                       Height="44" Stretch="Uniform" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Химчистка"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource DarkContrast}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Пользователь: " FontSize="14" Foreground="#555"/>
                    <TextBlock x:Name="fio" Text="Гость"
                               VerticalAlignment="Center" FontSize="14"
                               FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Верхнее навигационное меню -->
        <Border x:Name="navBorder" DockPanel.Dock="Top" Background="#F0F7FF"
                BorderBrush="{StaticResource LightBlue}" BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem x:Name="menuCatalog" Header="Каталог услуг" Click="NavCatalog_Click"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                    <MenuItem x:Name="menuCart" Header="Корзина" Click="NavCart_Click"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                    <MenuItem x:Name="menuMyOrders" Header="Мои заказы" Click="NavMyOrders_Click"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                    <MenuItem x:Name="menuOrders" Header="Управление заказами" Click="NavOrders_Click"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}"/>
                    <MenuItem x:Name="menuTables" Header="Таблицы БД ▾"
                              FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DarkContrast}">
                        <MenuItem Header="Все таблицы (обзор и управление)" Click="NavTables_Click" FontWeight="Bold"/>
                        <Separator/>
                        <MenuItem Header="Услуги (product)" Tag="product" Click="NavTableItem_Click"/>
                        <MenuItem Header="Заказы (order)" Tag="order" Click="NavTableItem_Click"/>
                        <MenuItem Header="Состав заказов (productOrder)" Tag="productOrder" Click="NavTableItem_Click"/>
                        <MenuItem Header="Категории (category)" Tag="category" Click="NavTableItem_Click"/>
                        <MenuItem Header="Материалы (material)" Tag="material" Click="NavTableItem_Click"/>
                        <MenuItem Header="Единицы измерения (unit)" Tag="unit" Click="NavTableItem_Click"/>
                        <MenuItem Header="Статусы заказов (status)" Tag="status" Click="NavTableItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Пользователи (user)" Tag="user" Click="NavTableItem_Click"/>
                        <MenuItem Header="Роли пользователей (role)" Tag="role" Click="NavTableItem_Click"/>
                    </MenuItem>
                </Menu>

                <Button x:Name="btnAuthToggle" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Content="Выход" Click="NavAuthToggle_Click"
                        Background="{StaticResource SecondaryButtonColor}" Padding="12,3" Margin="4,0" FontSize="13"/>
            </DockPanel>
        </Border>

        <!-- Основной фрейм для переключения страниц -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
